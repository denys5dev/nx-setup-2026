{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noUncheckedSideEffectImports": false,
    "baseUrl": ".",
    "paths": {
      "@celestial/sirius/dashboard/domain": [
        "./libs/sirius/dashboard/domain/src/index.ts"
      ],
      "@celestial/sirius/dashboard/api": [
        "./libs/sirius/dashboard/api/src/index.ts"
      ],
      "@celestial/vega/dashboard/feature": [
        "./libs/vega/dashboard/feature/src/index.ts"
      ],
      "@celestial/vega/dashboard/domain": [
        "./libs/vega/dashboard/domain/src/index.ts"
      ],
      "@celestial/shared/ui/design-system": [
        "./libs/shared/ui/design-system/src/index.ts"
      ],
      "@celestial/shared/dashboard/contracts": [
        "./libs/shared/dashboard/contracts/src/index.ts"
      ]
    },
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  }
}
