{
  "name": "design-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/design-system/src",
  "prefix": "ds",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/shared/ui/design-system/.storybook",
        "browserTarget": "design-system:build-storybook",
        "styles": ["libs/shared/ui/design-system/src/styles/styles.scss"],
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/design-system",
        "configDir": "libs/shared/ui/design-system/.storybook",
        "browserTarget": "design-system:build-storybook",
        "styles": ["libs/shared/ui/design-system/src/styles/styles.scss"],
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "design-system:build-storybook",
        "staticFilePath": "dist/storybook/design-system",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "design-system:build-storybook:ci"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/shared/ui/design-system/tsconfig.lib.json",
          "tsc --noEmit -p libs/shared/ui/design-system/tsconfig.spec.json",
          "tsc --noEmit -p libs/shared/ui/design-system/.storybook/tsconfig.json"
        ],
        "parallel": false
      }
    }
  }
}
